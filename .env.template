# Bootstrap settings only.
# Runtime trading / model / exchange / prompt configuration is managed in
# /console/config and stored in PostgreSQL.

# Server Compose uses db; for local Python use 127.0.0.1 and your test port.
# URL-encode the password in DATABASE_URL; POSTGRES_PASSWORD is the raw value.
POSTGRES_USER=crypto_agent
POSTGRES_DB=crypto_agent
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://crypto_agent:change-this-database-password@db:5432/crypto_agent
APP_IMAGE=alphaply712/crypto-agent:latest
DB_POOL_MAX_SIZE=8
DB_CHECKPOINT_POOL_MAX_SIZE=2
DB_POOL_TIMEOUT_SECONDS=10
# Keep true for first configuration import; set false before starting scheduler.
DEPLOYMENT_MAINTENANCE=true
# Compose does not impose CPU or memory quotas.

# Console login password.
ADMIN_PASSWORD=123456
# JWT signing secret.
JWT_SECRET=change-this-jwt-secret
JWT_EXPIRE_HOURS=8
# Encryption key for secrets stored in PostgreSQL. Keep stable after import.
CONFIG_MASTER_KEY=change-this-config-master-key
# Server bootstrap settings.
HOST_PORT=31421
APP_PORT=7860
# For single-process runs only. Docker Compose overrides this and starts a
# dedicated scheduler container.
RUN_SCHEDULER_IN_WEB=true
SCHEDULER_MAX_WORKERS=2
TIMEZONE=Asia/Shanghai

# Optional BlockBeats key for initial configuration migration. Afterwards,
# manage it under Config > News aggregation; the database encrypts the key.
BLOCKBEATS_API_KEY=
# Legacy intelligence-feed tuning. Shared news providers and sources are
# configured in the console, including Jev scoring and a summary model.
NEWS_RISK_ENABLED=true
NEWS_MAX_ITEMS=6
NEWS_TOTAL_TIMEOUT_SECONDS=5
# Set a real contact address for official feeds that enforce user-agent policy.
NEWS_USER_AGENT=crypto-agent/1.0 contact@example.com

# MCP worker pools are separate from the Web pool. TIMEOUT_SECONDS bounds the
# caller response wait; physical workers keep ownership and finish after timeout.
# Each dependency request has its own timeout. Restart to resize pools.
MCP_READ_CONCURRENCY=4
MCP_EXECUTE_CONCURRENCY=2
MCP_AUTH_CONCURRENCY=2
MCP_RECOVERY_CONCURRENCY=2
MCP_RECOVERY_QUEUE_LIMIT=4
MCP_RECOVERY_TIMEOUT_SECONDS=20
MCP_STORAGE_CONCURRENCY=2
MCP_READ_QUEUE_LIMIT=8
MCP_EXECUTE_QUEUE_LIMIT=4
MCP_AUTH_QUEUE_LIMIT=4
MCP_QUEUE_SECONDS=2
MCP_READ_TIMEOUT_SECONDS=20
MCP_EXECUTE_TIMEOUT_SECONDS=40
MCP_AUTH_TIMEOUT_SECONDS=3
MCP_DEPENDENCY_TIMEOUT_SECONDS=8
MCP_DB_WAIT_SECONDS=0.25
MCP_MARKET_CACHE_SECONDS=300
MCP_MARKET_CACHE_RETRY_SECONDS=2
MCP_TICKER_CACHE_SECONDS=2
MCP_CANDLES_CACHE_SECONDS=15

# Process-wide commitments shared by MCP, Agent, scheduler, news, memory and
# catalogue work. Reserved critical workers are INCLUDED in the total.
# These finite defaults are calibration settings, not measured production limits.
RUNTIME_CAPACITY_ENABLED=true
RUNTIME_CAPACITY_TOTAL_WORKERS=8
RUNTIME_CAPACITY_RESERVED_WORKERS=2
RUNTIME_CAPACITY_QUEUE_LIMIT=16
RUNTIME_CAPACITY_QUEUE_SECONDS=2
RUNTIME_CAPACITY_ROLE_LIMITS={}
RUNTIME_CACHE_IDLE_SECONDS=300
RUNTIME_CATALOGUE_TTL_SECONDS=300
RUNTIME_CATALOGUE_RETRY_SECONDS=2

# Page sizes control database I/O, never the total ownership-index work.
# Full records are read regardless of size. Memory pressure is telemetry only.
PAPER_SCAN_BATCH_SIZE=20
PAPER_HISTORY_SCAN_LIMIT=100
RUNTIME_SCAN_BATCH_SIZE=32

# Bounded evidence survives restarts in DATA_DIR/resource_evidence.
# RESOURCE_EVIDENCE_FILES is backup count, PLUS one current file per process.
RESOURCE_SAMPLE_SECONDS=3
RESOURCE_EVIDENCE_BYTES=1048576
RESOURCE_EVIDENCE_FILES=4
RESOURCE_STAGE_BUFFER=64
RESOURCE_PRESSURE_FRACTION=0.85
# IMAGE_REVISION is set by the Docker build; CAPACITY_PROFILE_SHA256 by the
# isolated verifier or a subsequently authorized, validated production rollout.
# Per-container expectations come from the selected profile; set these only
# with the corresponding Docker limits, separately for Web and scheduler:
# RESOURCE_EXPECTED_MEMORY_BYTES=1073741824
# RESOURCE_EXPECTED_MEMORY_SWAP_TOTAL_BYTES=1207959552
# RESOURCE_EXPECTED_CPU_CPUS=1
